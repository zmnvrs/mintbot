# Copy this file to .env for local testing. Never commit a real .env
# (it holds the bot token). On Render, set these in the dashboard instead.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Reward paid per account after the user's first mint through the
# bot (default 3). Paid in USDT from the owner's W1 wallet, one claim
# per Telegram account. W1 must hold enough USDT or the bot tells the
# user plainly that the reward pool is empty.
# Economics: at W1's base referral tier (5% = ~$2.30 per 10-share
# mint) paying $3 loses ~$0.70 per user, until W1 reaches silver
# (10% at 10 invites, ~$4.60) or gold (15% at 100 invites, ~$6.87).
CLAIM_USD=3

# Minimum BNB value in USD to be eligible (default 41)
MIN_BNB_USD=41

# Owner contact shown in the welcome message
OWNER_CONTACT=@imzaman7

# Invite link for the channel users must join (Join Channel button)
CHANNEL_INVITE_URL=https://t.me/+s2WrevCJwkFkOTVl

# Channels users must join, comma-separated @handles or numeric chat IDs
# (OPTIONAL — leave empty and joining the channel is not required to
# mint; the Join Channel button still shows). The invite link does NOT
# work here — getChatMember needs the channel's @handle or its numeric
# ID (e.g. -1001234567890). To get the numeric ID, forward any message
# from the channel to @getmyid_bot.
# Example: TASK_CHANNELS=@mychannel1,@mychannel2
# The bot must be an admin of each channel, or membership cannot be checked.
TASK_CHANNELS=

# Reward text shown in the welcome message
REWARD_TEXT=$3 per account

# Public URL of this app, e.g. https://mintbot-xxxx.onrender.com
# Used by the /setwebhook helper route.
WEBHOOK_URL=

# BSC JSON-RPC endpoint (public, no key needed)
BSC_RPC=https://bsc-dataseed.bnbchain.org

# Per-user baw sessions: one HOME dir per Telegram user id, e.g.
# ~/.baw-users/123456789/. Never point this at a real wallet's HOME.
BAW_USERS_HOME=~/.baw-users

# The owner's W1 baw session HOME — used ONLY to pay $3 claims (and
# to read referral state). Never used to mint through this bot.
# NOTE: this session lives on the owner's own machine. On Render it
# does not exist, so claims cannot be paid from Render until the
# owner funds W1 and the W1 session is present on the host.
W1_BAW_HOME=/home/hatch

# Where per-user bot records live (paired address, mint/claim state,
# pending QR). Defaults to <BAW_USERS_HOME>/state.json.
BAW_STATE_FILE=

# baw binary path (default: whatever is on PATH after install).
BAW_BIN=
