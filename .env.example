# Copy this file to .env for local testing. Never commit a real .env
# (it holds the bot token). On Render, set these in the dashboard instead.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Mint — the bot serves its OWN mint page, no external site needed.
#
# When WEBHOOK_URL is set (below), the Mint 5 / Mint 10 buttons open
# this app's own page at {WEBHOOK_URL}/mint?qty=5 (or qty=10). The
# page connects the user's own wallet via WalletConnect and calls the
# Agent ID (AI) mint contract on BNB Smart Chain directly, with the
# referrer set to W1's BSC address
# (0xE012133823df5452de9c10a73fE935d26B995A97) so the referral bonus
# goes to W1. Verified on-chain: base referral rate is 5% (10% at 10
# invites, 15% at 100), and the reward must be claimed via claimOwed()
# — it is not sent automatically.
#
# The MINT_URL / MINT_URL_5 / MINT_URL_10 links below are only a
# FALLBACK, used when WEBHOOK_URL is not set (e.g. running the bot in
# polling mode with no public URL). The old agentidai.meme site is
# DEAD (NXDOMAIN) and was Safe Browsing phishing-flagged — do not
# rely on it. If you use a fallback link, never use a ?ref= code from
# anyone else.
MINT_URL=https://agentidai.meme/?ref=0xE012133823df5452de9c10a73fE935d26B995A97&qty={qty}
#
# 2) Or a separate link for each button (both must be set to be used).
#    When both are set they are used instead of MINT_URL.
MINT_URL_5=
MINT_URL_10=

# WalletConnect project ID for the mint page's wallet connect.
# Get one free at https://cloud.walletconnect.com (create a project,
# copy its Project ID). Empty = wallet connect is not configured yet;
# the mint page says so and cannot connect a wallet.
WC_PROJECT_ID=

# Instant sell after a mint: "1" to auto-sell the AI tokens right
# after a mint (default off). Keep OFF unless the sell economics have
# been verified live. Live quotes (2026-11-22): a 10-share mint costs
# 0.078 BNB and the AI received sells back for ~0.077 BNB — the sell
# loses ~$0.60 plus gas, it is NOT a profit and NOT a "reward".
# The page always shows the live cost vs sell value and warns first.
ENABLE_INSTANT_SELL=0

# Minimum BNB value in USD to be eligible (default 41)
MIN_BNB_USD=41

# Owner contact shown in the welcome message
OWNER_CONTACT=@imzaman7

# Invite link for the channel users must join (Join Channel button)
CHANNEL_INVITE_URL=https://t.me/+s2WrevCJwkFkOTVl

# Channels users must join, comma-separated @handles or numeric chat IDs
# (OPTIONAL — leave empty and joining the channel is not required to
# mint; the Join Channel button still shows). The invite link does NOT
# work here — getChatMember needs the channel's @handle or its numeric
# ID (e.g. -1001234567890). To get the numeric ID, forward any message
# from the channel to @getmyid_bot.
# Example: TASK_CHANNELS=@mychannel1,@mychannel2
# The bot must be an admin of each channel, or membership cannot be checked.
TASK_CHANNELS=

# Reward text shown in the welcome message
REWARD_TEXT=$3 per account

# Public URL of this app, e.g. https://mintbot-xxxx.onrender.com
# Used by the /setwebhook helper route.
WEBHOOK_URL=
